extends RefCounted
## Learning content: planets (topics), their dialogs and space encounters.
## Every line exists in each target language (en, es) with hints in each UI language (uk, ru).
## In "options" the FIRST option is the correct one; the game shuffles them.
## To add a language: add its key (e.g. "de") to every npc line and option.

const TARGET_LANGS := ["en", "es"]


static func q(id: String, npc: Array, tr: Array, options: Array, ans: Array, explain: Array) -> Dictionary:
	var opts: Array = []
	for o in options:
		opts.append({"en": o[0], "es": o[1]})
	return {
		"id": id,
		"npc": {"en": npc[0], "es": npc[1]},
		"tr": {"uk": tr[0], "ru": tr[1]},
		"options": opts,
		"ans_tr": {"uk": ans[0], "ru": ans[1]},
		"explain": {"uk": explain[0], "ru": explain[1]},
	}


